#
# Sem ele, POST /api/uso devolve 503 e nenhuma automacao consegue
# reportar — de proposito. Hub sem segredo configurado nao aceita
# reporte de ninguem, em vez de aceitar de todo mundo.
UP_HUB_CHAVE_USO=
